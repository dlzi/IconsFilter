<?php namespace ProcessWire;

class IconsFilter extends WireData implements Module {

    const VERSION = 3;

    public static function getModuleInfo(): array {
        return [
            'title'    => 'Icons Filter',
            'version'  => self::VERSION,
            'summary'  => 'Enables filtering of icons by name in the InputfieldIcon view.',
            'author'   => 'Daniel Zilli',
            'icon'     => 'filter',
            'autoload' => 'template=admin',
            'requires' => ['InputfieldIcon'],
        ];
    }

    public function init(): void {
        $this->addHookAfter('InputfieldIcon::render', function(HookEvent $event): void {
            $config     = $this->wire()->config;
            $modulePath = $config->urls->siteModules . 'IconsFilter/';
            $v          = self::VERSION;

            $config->styles->add("{$modulePath}IconsFilter.css?v={$v}");
            $config->scripts->add("{$modulePath}IconsFilter.js?v={$v}");
        });
    }
}